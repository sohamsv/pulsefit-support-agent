# Copy the needed lines into the project's .env (never commit .env)
STAFF_PASSCODE=choose-a-staff-passcode
API_SECRET=a-long-random-string          # signs staff and member session tokens
CORS_ORIGINS=http://localhost:3000       # comma-separated list of website URLs allowed to call the API
# Rate limits (the free Gemini tier allows about 15 requests a minute; one chat message uses 2 to 3)
CHAT_PER_IP_PER_MIN=4
CHAT_GLOBAL_PER_MIN=5
CHAT_CONCURRENCY=2
TRIAL_PER_IP_PER_HOUR=3
# TRUST_PROXY=1                          # set when behind a proxy so the real visitor IP is used
# PULSE_TICKETS_FILE=api/data/tickets.csv
